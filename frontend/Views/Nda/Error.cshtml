@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">An error occurred</h1>
<p class="lead">Something went wrong while processing your request.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

<a asp-action="Index" class="btn btn-primary">Back to form</a>

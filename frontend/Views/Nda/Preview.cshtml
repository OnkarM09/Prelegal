@model RenderedDocument
@{
    ViewData["Title"] = "Preview";
    var form = (NdaFormModel)ViewBag.Form;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h1 class="h4 mb-0">Preview</h1>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">&larr; Edit</a>
                @* asp-action + POST auto-injects the antiforgery token; no manual call needed. *@
                <form asp-action="Download" method="post" class="m-0">
                    @* Re-post the entered values so the PDF matches this preview. *@
                    <input type="hidden" name="EffectiveDate" value="@(form.EffectiveDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="Party1Name" value="@form.Party1Name" />
                    <input type="hidden" name="Party1EntityType" value="@form.Party1EntityType" />
                    <input type="hidden" name="Party1Address" value="@form.Party1Address" />
                    <input type="hidden" name="Party2Name" value="@form.Party2Name" />
                    <input type="hidden" name="Party2EntityType" value="@form.Party2EntityType" />
                    <input type="hidden" name="Party2Address" value="@form.Party2Address" />
                    <input type="hidden" name="Purpose" value="@form.Purpose" />
                    <input type="hidden" name="TermMonths" value="@form.TermMonths" />
                    <input type="hidden" name="ConfidentialityPeriodMonths" value="@form.ConfidentialityPeriodMonths" />
                    <input type="hidden" name="GoverningLaw" value="@form.GoverningLaw" />
                    <button type="submit" class="btn btn-primary">&#11015; Download PDF</button>
                </form>
            </div>
        </div>

        <article class="card">
            <div class="card-body px-4 px-md-5 py-4 document">
                <h2 class="h4 text-center mb-4">@Model.Title</h2>
                @foreach (var sec in Model.Sections)
                {
                    <section class="mb-4">
                        <h3 class="h6 fw-bold">@sec.Heading</h3>
                        @* Split only on blank lines (paragraph breaks). Single newlines
                           inside a value (e.g. a multi-line address) stay within one
                           paragraph and render via white-space: pre-wrap. *@
                        @foreach (var para in sec.Body.Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
                        {
                            <p class="mb-2" style="white-space: pre-wrap;">@para</p>
                        }
                    </section>
                }
            </div>
        </article>
    </div>
</div>

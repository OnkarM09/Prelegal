<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Prelegal NDA Creator</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Nda" asp-action="Index">
                &#128196; Prelegal
            </a>
            <span class="navbar-text text-white-50">Mutual NDA Creator</span>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <footer class="border-top text-muted py-3 mt-auto">
        <div class="container small">
            &copy; @DateTime.Now.Year Prelegal &mdash;
            Informational prototype, not legal advice. Have an attorney review before use.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
